<fonts-modification version="1">
    <family customizationType="new-named-family" name="radikal">
        <font weight="300" style="normal">Radikal-Regular.ttf</font>
    </family>
    <alias name="radikal-semi-bold" to="radikal" weight="600" />
    <alias name="radikal-bold" to="radikal" weight="700" />
    <alias name="times" to="radikal" />
    <alias name="times new roman" to="radikal" />
    <alias name="palatino" to="radikal" />
    <alias name="georgia" to="radikal" />
    <alias name="baskerville" to="radikal" />
    <alias name="goudy" to="radikal" />
    <alias name="fantasy" to="radikal" />
    <alias name="ITC Stone Serif" to="radikal" />
</fonts-modification>
